# Скопируйте в backend/.env на сервере (файл .env не коммитится).
# Синхронизируйте значения DB_* с docker-compose.yml / продакшен-секретами.

APP_NAME="Migraine AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Europe/Moscow

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=migraine
DB_USERNAME=migraine
DB_PASSWORD=change_me_strong

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

CACHE_STORE=database
QUEUE_CONNECTION=database

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Почта — по необходимости
MAIL_MAILER=log

# Сиды (первый запуск)
# DEFAULT_USER_EMAIL=demo@example.com
# ADMIN_USER_EMAIL=admin@example.com
